{
  "name": "blobbi-3d",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A procedural 3D Blobbi: the same seed-derived identity as the 2D procedural Blobbi, rendered as a reusable Babylon.js game character.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "headless": "vite build --ssr src/rumble/headless-cli.ts --outDir .headless --emptyOutDir --logLevel warn && node .headless/headless-cli.js"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/havok": "^1.3.14",
    "@blobbi-kit/3d": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
