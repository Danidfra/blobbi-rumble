# Blobbi Rumble server settings (compose.yaml / npm run serve). Copy to .env and adjust:
#   cp .env.example .env
# The values below are the production ones for https://rumble.blobbi.pet. There are no secrets here, and none
# belong in .env (the server needs no private key). .env is ignored by git and by the Docker build.

# The one public address: identity proofs must name wss://rumble.blobbi.pet/ws; share links use it.
PUBLIC_URL=https://rumble.blobbi.pet
# Only pages from the public origin may open the game's WebSocket.
ALLOWED_ORIGINS=https://rumble.blobbi.pet
# Cloudflare Tunnel sets this header to the player's address. Only because the port is published on the host's
# loopback (so nothing but the tunnel can reach it) is it safe to trust; leave empty without such a proxy.
CLIENT_IP_HEADER=cf-connecting-ip
# The one peer believed when it sets CLIENT_IP_HEADER: this project's Docker network gateway (RUMBLE_GATEWAY below).
# cloudflared connects to 127.0.0.1:<RUMBLE_HOST_PORT>; Docker hands that connection to the container from the
# gateway. Keep it equal to RUMBLE_GATEWAY. Not "private" (it would believe any private address).
TRUSTED_PROXIES=172.31.250.1

SERVER_NAME=Blobbi Rumble
# Optional: who runs the server, as an npub (shown as a claim, never trusted for anything).
OPERATOR_PUBKEY=

MAX_CONNECTIONS=64
MAX_ROOMS=16
# A private room nobody plays or moves in closes after this many minutes (warned 2 min and 30 s before); 0: never.
ROOM_IDLE_MINUTES=20

# The host port the tunnel forwards to (published on 127.0.0.1 only).
RUMBLE_HOST_PORT=8080
# The image to run: the short commit being deployed, set before building (required; never "latest"):
#   sed -i "s/^RUMBLE_TAG=.*/RUMBLE_TAG=$(git rev-parse --short HEAD)/" .env
# Rollback: the previous commit's tag (its image is still on the host), then `docker compose up -d --no-build`.
RUMBLE_TAG=

# This project's own Docker network (a fixed range so its gateway is known). Change all three together if the
# range is taken on the host ("Pool overlaps"): RUMBLE_SUBNET, RUMBLE_GATEWAY and TRUSTED_PROXIES.
RUMBLE_SUBNET=172.31.250.0/29
RUMBLE_GATEWAY=172.31.250.1
